{
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "editor.formatOnSave": true,

  "stylelint.useLocal": true,
  "stylelint.autoFixOnSave": true,

  "cSpell.language": "en,ru",
  "cSpell.words": ["reduxjs", "stylelint", "prettierrc", "eslintignore", "stylelintignore"],

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, yarn.lock, .stylelintrc, .stylelintignore, .eslintrc, .eslintignore, .prettierrc, .prettierignore",
    "tsconfig.json": "tsconfig.*.json"
  }
}
